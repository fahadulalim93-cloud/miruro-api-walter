# === Required for production ===

# Comma-separated list of allowed origins (your frontend URLs)
# Example: https://luffytv-fahad.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://luffytv-fahad.vercel.app,http://localhost:3000

# === Optional ===

# Set an API key to allow programmatic access without Origin/Referer check
# Clients must send x-api-key header with this value
# API_KEY=your-secret-api-key-here
